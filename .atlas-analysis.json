  "projectType": "api-service",
  "projectName": "PURPS API",
  "projectDescription": "A no-key REST API for launching, managing, and trading meme coins across Solana, pump.fun, and Robinhood Chain, where trading fees are automatically routed to holder strategies such as buybacks, airdrops, and perpetual futures.",
  "theme": "luma",
